# ==========================================
# Production-ready .gitignore for collab-grok
# Node.js + TypeScript + Vite (React) + Docker
# ==========================================

# --- Dependencies ---
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.yarn/sdks
.yarn/versions

# --- Environment & Secrets (CRITICAL: never commit keys) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Keep example for reference
!.env.example

# --- Build / Output Directories ---
dist/
build/
out/
.next/
.nuxt/
.vuepress/dist/
.serverless/
.fusebox/
.dynamodb/
.tern-port
client/dist/
server/dist/
*.tsbuildinfo

# --- Logs & Debug ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
server.log
pnpm-debug.log*

# --- Runtime / Generated Data (per-user or per-run) ---
data/
exports/
context-packs/
*.pid
*.seed
*.pid.lock

# --- OS & Editor Generated ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.project
.classpath
.c9/
*.launch
.settings/
*.iml
*.ipr
*.iws
.vscode-test/
.history/

# --- TypeScript / Build Caches ---
*.tsbuildinfo
.tscache/
.eslintcache
.stylelintcache
.cache/
.parcel-cache/
.vite/
vite.config.*.timestamp-*.mjs

# --- Testing / Coverage (future-proof) ---
coverage/
.nyc_output/
*.lcov
jest-cache/
jest-stare/

# --- Misc Build & Tooling ---
*.tmp
*.temp
.grunt/
bower_components/
jspm_packages/
web_modules/
.yarn-integrity
.env.test
.cache
.serverless
.fusebox
.dynamodb
.tern-port
.vscode-test
.yarn-integrity

# --- Package Manager Lockfiles (commit these!) ---
# DO commit package-lock.json / yarn.lock / pnpm-lock.yaml
# (they are NOT listed here)

# --- Docker / Container (usually commit Dockerfile + .dockerignore) ---
# Nothing to ignore here by default

# --- Keep runtime directories after clone (via .gitkeep) ---
!data/.gitkeep
!data/rooms/.gitkeep
!exports/.gitkeep
!context-packs/.gitkeep

# --- End of .gitignore ---
