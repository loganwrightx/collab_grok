# xAI / Grok API key (required). Get one at https://x.ai/api or console.grok.com
XAI_API_KEY=your_xai_api_key_here

# Optional: Model to use (default: grok-3)
# XAI_MODEL=grok-3

# Server port (default 3000)
PORT=3000

# Auth & DB
JWT_SECRET=change-this-to-a-long-random-string
DB_PATH=./data/collab.db

# Email for verification (optional for dev - will log code if not set)
# Use e.g. Resend, SendGrid, or Gmail SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@loganwright.tech
