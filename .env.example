# Grok API key (required). Get one at https://x.ai/api or console.grok.com — this is the ONLY ongoing cost.
XAI_API_KEY=your_xai_api_key_here

# Optional: Model to use (default: grok-3). Can be grok-3, grok-4 etc.
# XAI_MODEL=grok-3

# Server port (default 3000). Platforms like Render set this automatically.
PORT=3000

# Auth secret for JWT cookies (30-day sessions). Use a long random string in prod.
JWT_SECRET=change-this-to-a-long-random-string

# Database path. For local: ./data/collab.db (code auto-creates dir)
# For Render free tier persistence: set DB_PATH=/data/collab.db AFTER adding a Persistent Disk (see README).
DB_PATH=./data/collab.db

# Email / SMTP for account verification codes + optional room activity notifications.
# Cloudflare DNS + addresses (noreply@loganwright.tech, contact@loganwright.tech) are for the domain only.
# Cloudflare Email Routing handles *receiving* only. For *sending*, you need an SMTP relay/provider.
# Recommended free/low-volume: Brevo (brevo.com) — 300 emails/day free tier.
#   1. Sign up, add & verify domain loganwright.tech (add the DKIM/SPF TXT records they give you to your Cloudflare DNS).
#   2. Go to SMTP settings in Brevo, generate an SMTP key.
#   3. Use:
#      SMTP_HOST=smtp-relay.brevo.com
#      SMTP_PORT=587
#      SMTP_USER=your-brevo-account-email (or the one shown)
#      SMTP_PASS=the-smtp-key-from-brevo
#      SMTP_FROM=noreply@loganwright.tech   # or contact@loganwright.tech (must be allowed sender in the provider)
#
# Alternatives: Resend, Mailgun, Postmark, or your Google/Microsoft 365 SMTP if the domain is in Workspace.
# If SMTP_HOST is not set, codes are logged to server console (dev only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@loganwright.tech

# Optional but recommended for email links (verification + notifications): your public URL
# PUBLIC_URL=https://collab.loganwright.tech
PUBLIC_URL=
